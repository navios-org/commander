{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "outDir": "dist",
    "rootDir": "src",
    "lib": [
      "ES2023",
      "ESNext.Disposable",
      "esnext.decorators"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "emitDeclarationOnly": false,
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ]
}
