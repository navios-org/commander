{
  "name": "@navios/tui-adapter-ink",
  "version": "1.2.1",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/commander.git",
    "directory": "packages/tui-adapter-ink"
  },
  "type": "module",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      }
    }
  },
  "scripts": {
    "check": "yarn run -T tsc --build",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "build": "yarn run -T tsdown",
    "publish:pkg": "yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "ink-syntax-highlight": "^2.0.2"
  },
  "devDependencies": {
    "@navios/commander-tui": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "strip-ansi": "^7.2.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@navios/commander-tui": "^1.3.0",
    "@navios/core": "*",
    "react": ">=19.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
