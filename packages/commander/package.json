{
  "name": "@navios/commander",
  "version": "2.0.0-alpha.0",
  "description": "Decorator-based command line framework: a transport of @navios/core",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/commander.git",
    "directory": "packages/commander"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./lib/index.*",
    "./lib/legacy-compat/index.*",
    "./lib/testing/index.*",
    "./lib/*cli-transport*",
    "./lib/*output*"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./lib/testing/index.d.mts",
        "default": "./lib/testing/index.mjs"
      },
      "require": {
        "types": "./lib/testing/index.d.cts",
        "default": "./lib/testing/index.cjs"
      }
    },
    "./legacy-compat": {
      "import": {
        "types": "./lib/legacy-compat/index.d.mts",
        "default": "./lib/legacy-compat/index.mjs"
      },
      "require": {
        "types": "./lib/legacy-compat/index.d.cts",
        "default": "./lib/legacy-compat/index.cjs"
      }
    }
  },
  "scripts": {
    "check": "yarn run -T tsc -b",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test": "vitest",
    "test:ci": "vitest run",
    "build": "yarn run -T tsdown",
    "publish:pkg": "yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "devDependencies": {
    "@navios/core": "^2.0.0-alpha.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@navios/core": "^2.0.0-alpha.1",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
