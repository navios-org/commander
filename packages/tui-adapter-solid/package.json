{
  "name": "@navios/tui-adapter-solid",
  "version": "1.1.1",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/commander.git",
    "directory": "packages/tui-adapter-solid"
  },
  "type": "module",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      }
    }
  },
  "scripts": {
    "check": "yarn run -T tsc --build",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test": "bun test",
    "test:ci": "bun test",
    "build": "yarn run -T tsdown",
    "publish:pkg": "yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "dependencies": {
    "@opentui/core": "^0.9.7",
    "@opentui/solid": "^0.9.7",
    "solid-js": "^1.9.20",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@navios/commander-tui": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "@types/bun": "^1.4.5",
    "rolldown-plugin-solid": "^0.2.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@navios/commander-tui": "^1.3.0",
    "@navios/core": "*"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=26.4.0"
  }
}
