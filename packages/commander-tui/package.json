{
  "name": "@navios/commander-tui",
  "version": "2.0.0-alpha.0",
  "description": "Terminal interface for Navios applications: screens, logs, progress and prompts",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/commander.git",
    "directory": "packages/commander-tui"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./lib/react/index.d.mts",
        "default": "./lib/react/index.mjs"
      },
      "require": {
        "types": "./lib/react/index.d.cts",
        "default": "./lib/react/index.cjs"
      }
    }
  },
  "scripts": {
    "check": "yarn run -T tsc --build",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test": "vitest",
    "test:ci": "vitest run",
    "build": "yarn run -T tsdown",
    "publish:pkg": "yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@navios/core": "^2.0.0-alpha.1",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@navios/core": "^2.0.0-alpha.1",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
