  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/commander.git",
    "directory": "packages/tui-adapter-react"
  },
  "type": "module",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      }
    }
  },
  "scripts": {
    "check": "yarn run -T tsc --build",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test": "bun test",
    "test:ci": "bun test",
    "build": "yarn run -T tsdown",
    "publish:pkg": "yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "dependencies": {
    "@opentui/core": "^0.9.7",
    "@opentui/react": "^0.9.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@navios/commander-tui": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@navios/commander-tui": "^2.0.0-alpha.0",
    "react": ">=19.0.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=26.4.0"
  }
